{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Test Result",
  "type": "object",
  "required": [
    "capability",
    "gate",
    "status",
    "evidence"
  ],
  "properties": {
    "capability": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "BLOCKED_EXTERNAL",
        "SKIPPED"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "model_calls": {
      "type": [
        "integer",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
