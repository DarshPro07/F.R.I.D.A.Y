# Golden failures corpus (PRD v3.1 7.3): past bugs as durable, replayable objectives. Each line names the defect it guards; all run through the same harness as objectives.jsonl.
{"id": "GO-recovery-101", "category": "recovery", "objective": "watchdog reconciles a run whose owner died after scheduling a wake", "tasks": [{"capability": "golden_flaky", "arguments": {"fail_times": 1}}], "expect": {"status": "COMPLETED", "capabilities": ["golden_flaky"], "max_seconds": 20, "max_model_calls": 0}, "tags": ["golden_failure", "watchdog_next_wake", "2026-09-05"], "note": "RunWatchdog._is_orphan ignored any run with next_wake set; a crash after a wake was scheduled was never reconciled by a fresh control plane (fixed in continuous.py; full process-kill version in tests/test_chaos_restart.py)."}
{"id": "GO-recovery-102", "category": "recovery", "objective": "a retried attempt is a recorded event not an inference from a counter", "tasks": [{"capability": "golden_flaky", "arguments": {"fail_times": 2}}], "expect": {"status": "COMPLETED", "capabilities": ["golden_flaky"], "max_seconds": 20, "max_model_calls": 0}, "tags": ["golden_failure", "task_retry_event", "2026-09-05"], "note": "FR-054: the engine wrote no event on retry, so a trace could not show the failure kind or the decision to retry (EVENT_TASK_RETRY added)."}
{"id": "GO-security-101", "category": "security", "objective": "a forged approved_by argument grants nothing", "tasks": [{"capability": "files_create", "arguments": {"path": "{{files}}/forged.py", "content": "x", "approved_by": "boss"}}], "setup": {"autonomy": "guarded"}, "expect": {"status": "WAITING_PERMISSION", "capabilities": ["files_create"], "max_seconds": 15, "max_model_calls": 0, "policy": {"blocked": ["files_create"]}, "files_absent": ["forged.py"]}, "tags": ["golden_failure", "approval_forgery", "2026-09-05"], "note": "FR-060: only an APPROVED record on the run answers an ASK; a marker a model could write into arguments must not."}
{"id": "GO-general-101", "category": "general", "objective": "how many monitors do I have", "expect": {"status": "COMPLETED", "capabilities": ["system_displays"], "forbid": ["get_world_news", "youtube_channel_details"], "max_seconds": 20, "max_model_calls": 0}, "tags": ["golden_failure", "planner_no_target_fallback", "2026-09-05"], "note": "The planner's no-target fallback took the first eight READ capabilities in registry order, routing a monitor question to world news / YouTube."}
{"id": "GO-general-102", "category": "general", "objective": "which windows are open right now", "expect": {"status": "COMPLETED", "capabilities": ["windows_list"], "max_seconds": 20, "max_model_calls": 0}, "tags": ["golden_failure", "planner_informational_shape", "2026-09-05"], "note": "A READ question with a single LIST-shaped candidate was left unresolved as if LIST were a different action; both are informational."}
{"id": "GO-general-103", "category": "general", "objective": "what is the screen brightness", "expect": {"status": "COMPLETED", "capabilities": ["brightness_get"], "forbid": ["vision_inspect_screen"], "max_seconds": 20, "max_model_calls": 0}, "tags": ["golden_failure", "planner_noun_overrule", "2026-09-05"], "note": "The noun 'screen' fixed the target to VISION although brightness_get's own examples fit the words decisively."}
{"id": "GO-browser-101", "category": "browser", "objective": "fetch {{web:/fixture}} through netguard", "tasks": [{"capability": "web_fetch", "arguments": {"url": "{{web:/fixture}}"}}], "setup": {"web": {"/fixture": "<html><body>fixture</body></html>"}}, "expect": {"status": "COMPLETED", "capabilities": ["web_fetch"], "max_seconds": 15, "max_model_calls": 0}, "tags": ["golden_failure", "netguard_evaluation_fixture", "2026-09-05"], "note": "Loopback is refused by netguard by design; the runner registers exactly one loopback origin in-process for one case (netguard.evaluation_fixture) - never via environment."}
{"id": "GO-memory-101", "category": "memory", "objective": "remember a preference with the kind spelled the way the store expects", "tasks": [{"capability": "memory_remember", "arguments": {"subject": "golden kind", "value": "upper-cased kinds", "kind": "PREFERENCE"}}], "expect": {"status": "COMPLETED", "capabilities": ["memory_remember"], "max_seconds": 15, "max_model_calls": 0, "memory": ["upper-cased kinds"]}, "tags": ["golden_failure", "memory_kind_case", "2026-09-05"], "note": "memory_remember refuses lower-case kinds ('preference'); the corpus generator wrote them lower-case and every memory case failed."}
{"id": "GO-general-109", "category": "general", "objective": "which windows are open right now", "expect": {"status": "COMPLETED", "capabilities": ["windows_list"], "forbid": ["open_in_browser", "apps_open"], "max_seconds": 20, "max_model_calls": 0, "clarifications": 0}, "tags": ["golden_failure", "planner_split_on_state_verb"], "defect": "2026-09-05: _SPLIT cut a question at the bare verb 'open' (a state, not a request) -> windows_list + open_in_browser, run PARTIAL; fixed by _split_requests (whitespace-only separator inside a question does not split)"}
{"id": "GO-memory-102", "category": "memory", "objective": "sort out the thing we discussed and send it over", "expect": {"status": "FAILED", "capabilities": ["objective.unmapped"], "forbid": ["power_sleep", "system_battery"], "max_seconds": 15, "max_model_calls": 0, "clarifications": 1, "evidence_min": false}, "tags": ["golden_failure", "runner_used_retired_splitter"], "defect": "2026-09-05: golden runner planned free text with the retired clause splitter, which mapped this to power_sleep + system_battery; runner now takes the production planner path and the request is handed back as one question"}
