 {
  "id": "NFR-P01",
  "priority": "",
  "text": "Voice interruption | \u2264300 ms median from detected user interruption to TTS stop | Voice telemetry"
 },
 {
  "id": "NFR-P02",
  "priority": "",
  "text": "First acknowledgement | \u2264700 ms median for voice acknowledgement where pipeline is healthy | End-to-end traces"
 },
 {
  "id": "NFR-P03",
  "priority": "",
  "text": "First meaningful stream | \u22641.5 s median for normal cloud-assisted conversational responses | Session traces"
 },
 {
  "id": "NFR-P04",
  "priority": "",
  "text": "UI state propagation | <250 ms local target | Event-to-render metric"
 },
 {
  "id": "NFR-P05",
  "priority": "",
  "text": "Control Room interactive | <2 s target on supported machine | Cold-start benchmark"
 },
 {
  "id": "NFR-P06",
  "priority": "",
  "text": "Memory retrieval | P95 <500 ms for local scoped retrieval target | Memory benchmark"
 },
 {
  "id": "NFR-P07",
  "priority": "",
  "text": "Simple local action | Preferred <2 s when no cloud reasoning is required | Golden actions"
 },
 {
  "id": "NFR-P08",
  "priority": "",
  "text": "Idle CPU | Target <5% average for core runtime | 15-minute idle profile"
 },
 {
  "id": "NFR-P09",
  "priority": "",
  "text": "Worker concurrency | 0\u20132 default active execution workers | Runtime governor"
 },
 {
  "id": "NFR-P10",
  "priority": "",
  "text": "Token efficiency | No full capability catalog or full memory dump by default | Context telemetry"
 },
 {
  "id": "NFR-P11",
  "priority": "",
  "text": "Gateway isolation | Inference-only Hermes calls load no tools/subagents unless promoted | Gateway traces"
 },
 {
  "id": "NFR-P12",
  "priority": "",
  "text": "Token growth guard | Abnormal recursive/repeated context is stopped before budget exhaustion | Synthetic runaway test"
 },
 {
  "id": "NFR-P13",
  "priority": "",
  "text": "Provider attribution | 100% of model-gateway calls attributed to objective + provider/model | Usage telemetry"
 }
]