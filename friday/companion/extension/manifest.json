{
  "manifest_version": 3,
  "name": "Friday Companion",
  "version": "0.1.0",
  "description": "Lets Friday observe and operate the browser you are already signed into. Nothing leaves this machine.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Friday: attend this tab"
  },
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": ""
}
