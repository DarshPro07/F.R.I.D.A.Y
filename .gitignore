# ---------------------------------------------------------------------------
# Secrets and identity. Never publish these.
#
# The companion key and token are what the browser bridge trusts: anyone
# holding them can present themselves as the paired extension. The face
# descriptors are biometric data about a real person and are not recoverable
# by rotation the way a token is.
# ---------------------------------------------------------------------------
data/companion/
data/owner_face.json
data/owner_pin.json

# ---------------------------------------------------------------------------
# Live state. These are databases and logs the running system writes; they
# hold real conversations, real memory and the owner's access history
# (client IPs and user agents). Tests never read them -- conftest's
# _never_the_real_database fixture redirects ADA_DB to a tmp_path.
# ---------------------------------------------------------------------------
data/ada.sqlite3
data/*.sqlite3
tmp*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
data/access_log.jsonl
data/consumed_nonces.json
data/consumed_nonces.json.tmp
data/deck_queue.json
data/response_style.json
data/evaluation/

# ---------------------------------------------------------------------------
# Generated at runtime: captures, synthesised speech, exports and the
# scratch workspaces the tools write into.
# ---------------------------------------------------------------------------
data/browser_shots/
data/tts_cache/
data/exports/
data/forge/staging/
data/workbench/
data/workspace/

# Kept deliberately: data/corpus/ (evaluation corpora, read by the eval code)
# and data/gate/ (document-extraction fixtures: CSV, PDF, XLSX). Both are
# checked-in inputs, not runtime output.

# Settings backups made before merging team-gen output (S1, jarvis-agentic-team).
.claude/settings.json.bak-*

# junction into the pinned agents-team clone (plugin marketplace shim)
.claude/marketplace/friday-local/agents-team/

# git worktrees checked out by coding agents (a registered worktree is
# tracked by .git/worktrees, never by the index; 70 MB of checkout here)
.claude/worktrees/

# ---------------------------------------------------------------------------
# Audit 2026-09-05 (A-001..A-006, A-055, A-056): nothing the running system
# writes, nothing built, nothing personal, nothing local-only is tracked.
# Fixtures the tests read stay: data/corpus/, data/gate/.
# ---------------------------------------------------------------------------
# databases anywhere (live, gate, scratch)
*.sqlite3
# runtime provider/objective state
data/provider_cooldowns.json
# benchmark / evaluation / verification outputs (CI artifacts, not source)
data/golden/
data/perf/
data/hermes/
data/post_*/
data/baseline/
data/artifacts/
data/prd_requirements.json
# captures and generated media
data/vision/
# biometric model (LBPH faces) and the companion pairing secrets
trainingData.yml
data/companion/
# built binaries and their backups
Friday.exe*
*.exe
!third_party/**/*.exe.sha256
# local tool state
.serena/project.local.yml
.aicodepro/checkpoints.git/
# the PRD is canonical as docs/PRD_V3.1.md; office/pdf renders are artifacts
*.docx
*.pdf
!data/gate/*.pdf
